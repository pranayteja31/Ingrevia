# ── Production Build ───────────────────────────────────────────────────────────
# REQUIRED for production EAS builds. Set this to your deployed backend URL.
# Example: EXPO_PUBLIC_API_URL=https://api.ingrevia.com
EXPO_PUBLIC_API_URL=

# ── Local Development Override (optional) ─────────────────────────────────────
# Leave blank to use Metro's auto-detected IP (recommended for most setups).
# Only set if auto-detection fails (VPN, WSL, custom tunnels).
# Example: EXPO_PUBLIC_DEV_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_DEV_API_URL=
