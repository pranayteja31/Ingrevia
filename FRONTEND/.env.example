# Production build
# Required for production EAS builds. Set this to your deployed backend URL.
# Example: EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=

# Local development override (optional)
# Leave blank to use Metro's auto-detected IP.
# Only set if auto-detection fails, for example with VPN, WSL, or tunnels.
# Example: EXPO_PUBLIC_DEV_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_DEV_API_URL=

# Change only if Django runs on a different local port.
EXPO_PUBLIC_BACKEND_PORT=8000
