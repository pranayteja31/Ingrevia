# Core
# Required for every environment. Keep the real value in backend/.env.
# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production.
DEBUG=True

# Comma-separated. Required when DEBUG=False.
# Example: api.example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# AI
# Get from https://aistudio.google.com/
GOOGLE_API_KEY=your-gemini-api-key-here

# CORS
# Comma-separated frontend origin URLs. Required when DEBUG=False.
# Expo web build example: https://app.example.com
# Leave empty for dev (all origins allowed when DEBUG=True).
FRONTEND_URL=

# Database
# Local testing:
#   DB_MODE=sqlite
# Cloud database:
#   DB_MODE=cloud
DB_MODE=sqlite

# Optional local SQLite file path. Leave blank for backend/db.sqlite3.
# SQLITE_NAME=

# Preferred cloud option for providers that give one connection string.
# Examples: Supabase, Neon, Railway, Render, Heroku Postgres.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# Alternative cloud option if your provider gives separate fields.
# Required only when DB_MODE=cloud and DATABASE_URL is blank.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=app_db
# DB_USER=app_user
# DB_PASSWORD=strong-password
# DB_HOST=db.example.com
# DB_PORT=5432
DB_ENGINE=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# Most managed PostgreSQL providers require SSL.
DB_SSL_REQUIRE=True
