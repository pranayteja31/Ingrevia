# ── Core ──────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated. Required when DEBUG=False.
# Example: api.ingrevia.com,www.ingrevia.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/
GOOGLE_API_KEY=your-gemini-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origin URLs. Required when DEBUG=False.
# Expo web build example: https://app.ingrevia.com
# Leave empty for dev (all origins allowed when DEBUG=True).
FRONTEND_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank for SQLite (development default).
# For production PostgreSQL:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=ingrevia_db
#   DB_USER=ingrevia_user
#   DB_PASSWORD=strong-password
#   DB_HOST=localhost
#   DB_PORT=5432
DB_ENGINE=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
